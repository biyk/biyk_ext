# Скопируйте в .env и скорректируйте под своё окружение (.env не попадает в git)
# Режим эксперта DeepSeek (true/false)
DEEPSEEK_USE_EXPERT=false
# Порт Flask-сервера (Foundry-часть ждёт 9999)
SERVER_PORT=9999
# Порт CDP браузера
CDP_PORT=9222
# Путь к браузеру для CDP-моста
BRAVE_PATH=C:\Program Files\BraveSoftware\Brave-Browser-Beta\Application\brave.exe
# Профиль браузера с залогиненным DeepSeek (по умолчанию server/profile)
DEEPSEEK_PROFILE_DIR=C:\Users\b5\Desktop\DeepWeb\profile
